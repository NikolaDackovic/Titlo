{
  "name": "exyu-titl-studio",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "benchmark": "tsx benchmark/scripts/run-benchmark.ts",
    "model:install": "tsx scripts/install-model.ts",
    "model:smoke": "tsx scripts/model-smoke.ts",
    "benchmark:v1": "tsx scripts/run-benchmark-v1.ts",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run integration",
    "test:model": "vitest run --config vitest.model.config.ts",
    "model:install:whisper": "tsx scripts/install-whisper.ts",
    "model:install:sh-en": "tsx scripts/install-model.ts --model sh-en",
    "model:smoke:sh-en": "tsx scripts/smoke-sh-en.ts",
    "benchmark:speech": "tsx benchmark/speech/scripts/run-asr-benchmark.ts",
    "benchmark:speech:build": "tsx benchmark/speech/scripts/build-datasets.ts",
    "benchmark:speech:add": "tsx benchmark/speech/scripts/add-real-sample.ts",
    "benchmark:speech:real": "tsx benchmark/speech/scripts/run-asr-benchmark.ts --datasets real-world --detect --qc --label real-world",
    "benchmark:speech:qc-summary": "tsx benchmark/speech/scripts/qc-review-summary.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "framer-motion": "^14.12.0",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "1.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "5.1.0"
  }
}
